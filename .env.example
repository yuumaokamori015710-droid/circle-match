# Copy this file to .env locally or set these values in your hosting provider.

# Server
HOST=127.0.0.1
PORT=8787

# App identity
CIRCLEMATCH_SITE_NAME=Circle Match
CIRCLEMATCH_OPERATOR=Circle Match 運営
CIRCLEMATCH_CONTACT_EMAIL=contact@example.com
CIRCLEMATCH_SITE_BASE_URL=http://127.0.0.1:8787
CIRCLEMATCH_ADMIN_USERNAME=admin
CIRCLEMATCH_ADMIN_PASSWORD=
CIRCLEMATCH_SESSION_SECRET=

# Supabase Auth
CIRCLEMATCH_SUPABASE_URL=
CIRCLEMATCH_SUPABASE_ANON_KEY=
# Enable only after configuring and testing custom SMTP in Supabase.
CIRCLEMATCH_EMAIL_AUTH_ENABLED=false

# Transactional event emails (server only). Share the verified sending domain
# with Supabase custom SMTP; never expose this API key in HTML or public JS.
CIRCLEMATCH_EMAIL_NOTIFICATIONS_ENABLED=false
CIRCLEMATCH_RESEND_API_KEY=
CIRCLEMATCH_EMAIL_FROM=Circle Match <notifications@circle-match.jp>

# Database
# For production, set this outside the Git repository or use a managed database in the next phase.
CIRCLEMATCH_DB_PATH=outputs/circlematch.sqlite
CIRCLEMATCH_PUBLIC_SEED_PATH=outputs/public_circles_seed.csv

# Online payments: default OFF. Never put real keys in this file.
# The application reads process environment variables, not .env automatically.
CIRCLEMATCH_ONLINE_PAYMENTS_ENABLED=false
CIRCLEMATCH_STRIPE_MODE=test
CIRCLEMATCH_STRIPE_SECRET_KEY=
CIRCLEMATCH_STRIPE_WEBHOOK_SECRET=
CIRCLEMATCH_STRIPE_CONNECT_WEBHOOK_SECRET=
CIRCLEMATCH_STRIPE_PLATFORM_ACCOUNT=
# Requires separate production approval, legal review and test-mode verification.
CIRCLEMATCH_STRIPE_LIVE_APPROVED=false
